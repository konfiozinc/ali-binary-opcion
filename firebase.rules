rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── FUNCIÓN: verificar si es admin ──────────────────────
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email == "damoatrader1015@gmail.com";
    }

    // ── FUNCIÓN: usuario autenticado ────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    // ── COLECCIÓN users ─────────────────────────────────────
    match /users/{uid} {
      // Cada usuario solo puede leer su propio doc
      allow read:   if isAuth() && (request.auth.uid == uid || isAdmin());
      // El admin puede leer/escribir todos
      allow write:  if isAdmin();
      // El propio usuario puede crear su doc (registro)
      allow create: if isAuth() && request.auth.uid == uid;
    }

    // ── COLECCIÓN signals ────────────────────────────────────
    match /signals/{signalId} {
      // Solo admin escribe
      allow write:  if isAdmin();
      // Usuarios autenticados pueden leer
      allow read:   if isAuth();
    }

    // ── COLECCIÓN results ────────────────────────────────────
    match /results/{resultId} {
      allow write:  if isAdmin();
      allow read:   if isAuth();
    }

    // ── COLECCIÓN settings ───────────────────────────────────
    match /settings/{doc} {
      allow write:  if isAdmin();
      allow read:   if isAuth();
    }
  }
}
